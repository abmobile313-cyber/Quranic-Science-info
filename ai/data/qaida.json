 مَالُهٗ وَمَا كَسَبَ"},{"ay":[111,3],"t":"سَيَصۡلٰي نَارًا ذَاتَ لَهَبٍ"},{"ay":[111,4],"t":"وَّامۡرَاَتُهٗ حَمَّالَةَ الۡحَطَبِ"}]},"w09d6":{"k":"ayat","items":[{"ay":[111,5],"t":"فِيۡ جِيۡدِهَا حَبۡلٌ مِّنۡ مَّسَدٍ"},{"ay":[109,1],"t":"قُلۡ يٰاَيُّهَا الۡكٰفِرُوۡنَ"},{"ay":[109,2],"t":"لَا اَعۡبُدُ مَا تَعۡبُدُوۡنَ"},{"ay":[109,3],"t":"وَلَا اَنۡتُمۡ عٰبِدُوۡنَ مَا اَعۡبُدُ"},{"ay":[109,4],"t":"وَلَا اَنَا عَابِدٌ مَّا عَبَدۡتُّمۡ"},{"ay":[109,5],"t":"وَلَا اَنۡتُمۡ عٰبِدُوۡنَ مَا اَعۡبُدُ"},{"ay":[109,6],"t":"لَكُمۡ دِيۡنُكُمۡ وَلِيَ دِيۡنِ"}]},"w10d1":{"k":"ayat","items":[{"ay":[107,1],"t":"اَرَءَيۡتَ الَّذِيۡ يُكَذِّبُ بِالدِّيۡنِ"},{"ay":[107,2],"t":"فَذٰلِكَ الَّذِيۡ يَدُعُّ الۡيَتِيۡمَ"},{"ay":[107,3],"t":"وَلَا يَحُضُّ عَلٰي طَعَامِ الۡمِسۡكِيۡنِ"},{"ay":[107,4],"t":"فَوَيۡلٌ لِّلۡمُصَلِّيۡنَ"},{"ay":[107,5],"t":"الَّذِيۡنَ هُمۡ عَنۡ صَلَاتِهِمۡ سَاهُوۡنَ"},{"ay":[107,6],"t":"الَّذِيۡنَ هُمۡ يُرَآءُوۡنَ"},{"ay":[107,7],"t":"وَيَمۡنَعُوۡنَ الۡمَاعُوۡنَ"},{"ay":[106,1],"t":"لِاِيۡلٰفِ قُرَيۡشٍ"}]},"w10d2":{"k":"ayat","items":[{"ay":[106,2],"t":"اٖلٰفِهِمۡ رِحۡلَةَ الشِّتَآءِ وَالصَّيۡفِ"},{"ay":[106,3],"t":"فَلۡيَعۡبُدُوۡا رَبَّ هٰذَا الۡبَيۡتِ"},{"ay":[106,4],"t":"الَّذِيۡ اَطۡعَمَهُمۡ مِّنۡ جُوۡعٍ وَّاٰمَنَهُمۡ مِّنۡ خَوۡفٍ"},{"ay":[105,1],"t":"اَلَمۡ تَرَ كَيۡفَ فَعَلَ رَبُّكَ بِاَصۡحٰبِ الۡفِيۡلِ"},{"ay":[105,2],"t":"اَلَمۡ يَجۡعَلۡ كَيۡدَهُمۡ فِيۡ تَضۡلِيۡلٍ"},{"ay":[105,3],"t":"وَّاَرۡسَلَ عَلَيۡهِمۡ طَيۡرًا اَبَابِيۡلَ"},{"ay":[105,4],"t":"تَرۡمِيۡهِمۡ بِحِجَارَةٍ مِّنۡ سِجِّيۡلٍ"},{"ay":[105,5],"t":"فَجَعَلَهُمۡ كَعَصۡفٍ مَّاۡكُوۡلٍ"}]},"w10d3":{"k":"ayat","items":[{"ay":[104,1],"t":"وَيۡلٌ لِّكُلِّ هُمَزَةٍ لُّمَزَةِ"},{"ay":[104,2],"t":"اِلَّذِيۡ جَمَعَ مَالًا وَّعَدَّدَهٗ"},{"ay":[104,3],"t":"يَحۡسَبُ اَنَّ مَالَهٗ اَخۡلَدَهٗ"},{"ay":[104,4],"t":"كَلَّا لَيُنۡ بَذَنَّ فِي الۡحُطَمَةِ"},{"ay":[104,5],"t":"وَمَا اَدۡرٰىكَ مَا الۡحُطَمَةُ"},{"ay":[104,6],"t":"نَارُ اللّٰهِ الۡمُوۡقَدَةُ"},{"ay":[104,7],"t":"الَّتِيۡ تَطَّلِعُ عَلَي الۡاَفۡـِٕدَةِ"},{"ay":[104,8],"t":"اِنَّهَا عَلَيۡهِمۡ مُّؤۡصَدَةٌ"}]},"w10d4":{"k":"ayat","items":[{"ay":[104,9],"t":"فِيۡ عَمَدٍ مُّمَدَّدَةٍ"},{"ay":[102,1],"t":"اَلۡهٰىكُمُ التَّكَاثُرُ"},{"ay":[102,2],"t":"حَتّٰي زُرۡتُمُ الۡمَقَابِرَ"},{"ay":[102,3],"t":"كَلَّا سَوۡفَ تَعۡلَمُوۡنَ"},{"ay":[102,4],"t":"ثُمَّ كَلَّا سَوۡفَ تَعۡلَمُوۡنَ"},{"ay":[102,5],"t":"كَلَّا لَوۡ تَعۡلَمُوۡنَ عِلۡمَ الۡيَقِيۡنِ"},{"ay":[102,6],"t":"لَتَرَوُنَّ الۡجَحِيۡمَ"},{"ay":[102,7],"t":"ثُمَّ لَتَرَوُنَّهَا عَيۡنَ الۡيَقِيۡنِ"}]},"w10d5":{"k":"ayat","items":[{"ay":[102,8],"t":"ثُمَّ لَتُسۡـَٔلُنَّ يَوۡمَئِذٍ عَنِ النَّعِيۡمِ"},{"ay":[101,1],"t":"اَلۡقَارِعَةُ"},{"ay":[101,2],"t":"مَا الۡقَارِعَةُ"},{"ay":[101,3],"t":"وَمَا اَدۡرٰىكَ مَا الۡقَارِعَةُ"},{"ay":[101,4],"t":"يَوۡمَ يَكُوۡنُ النَّاسُ كَالۡفَرَاشِ الۡمَبۡثُوۡثِ"},{"ay":[101,5],"t":"وَتَكُوۡنُ الۡجِبَالُ كَالۡعِهۡنِ الۡمَنۡفُوۡشِ"},{"ay":[101,6],"t":"فَاَمَّا مَنۡ ثَقُلَتۡ مَوَازِيۡنُهٗ"},{"ay":[101,7],"t":"فَهُوَ فِيۡ عِيۡشَةٍ رَّاضِيَةٍ"}]},"w10d6":{"k":"ayat","items":[{"ay":[101,8],"t":"وَاَمَّا مَنۡ خَفَّتۡ مَوَازِيۡنُهٗ"},{"ay":[101,9],"t":"فَاُمُّهٗ هَاوِيَةٌ"},{"ay":[101,10],"t":"وَمَا اَدۡرٰىكَ مَا هِيَهۡ"},{"ay":[101,11],"t":"نَارٌ حَامِيَةٌ"},{"ay":[100,1],"t":"وَالۡعٰدِيٰتِ ضَبۡحًا"},{"ay":[100,2],"t":"فَالۡمُوۡرِيٰتِ قَدۡحًا"},{"ay":[100,3],"t":"فَالۡمُغِيۡرٰتِ صُبۡحًا"},{"ay":[100,4],"t":"فَاَثَرۡنَ بِهٖ نَقۡعًا"}]},"w11d1":{"k":"ayat","items":[{"ay":[100,5],"t":"فَوَسَطۡنَ بِهٖ جَمۡعًا"},{"ay":[100,6],"t":"اِنَّ الۡاِنۡسَانَ لِرَبِّهٖ لَكَنُوۡدٌ"},{"ay":[100,7],"t":"وَاِنَّهٗ عَلٰي ذٰلِكَ لَشَهِيۡدٌ"},{"ay":[100,8],"t":"وَاِنَّهٗ لِحُبِّ الۡخَيۡرِ لَشَدِيۡدٌ"},{"ay":[100,9],"t":"اَفَلَا يَعۡلَمُ اِذَا بُعۡثِرَ مَا فِي الۡقُبُوۡرِ"},{"ay":[100,10],"t":"وَحُصِّلَ مَا فِي الصُّدُوۡرِ"},{"ay":[100,11],"t":"اِنَّ رَبَّهُمۡ بِهِمۡ يَوۡمَئِذٍ لَّخَبِيۡرٌ"},{"ay":[99,1],"t":"اِذَا زُلۡزِلَتِ الۡاَرۡضُ زِلۡزَالَهَا"},{"ay":[99,2],"t":"وَاَخۡرَجَتِ الۡاَرۡضُ اَثۡقَالَهَا"}]},"w11d2":{"k":"ayat","items":[{"ay":[99,3],"t":"وَقَالَ الۡاِنۡسَانُ مَا لَهَا"},{"ay":[99,4],"t":"يَوۡمَئِذٍ تُحَدِّثُ اَخۡبَارَهَا"},{"ay":[99,5],"t":"بِاَنَّ رَبَّكَ اَوۡحٰي لَهَا"},{"ay":[99,6],"t":"يَوۡمَئِذٍ يَّصۡدُرُ النَّاسُ اَشۡتَاتًا لِّيُرَوۡا اَعۡمَالَهُمۡ"},{"ay":[99,7],"t":"فَمَنۡ يَّعۡمَلۡ مِثۡقَالَ ذَرَّةٍ خَيۡرًا يَّرَهٗ"},{"ay":[99,8],"t":"وَمَنۡ يَّعۡمَلۡ مِثۡقَالَ ذَرَّةٍ شَرًّا يَّرَهٗ"},{"ay":[97,1],"t":"اِنَّا اَنۡزَلۡنٰهُ فِيۡ لَيۡلَةِ الۡقَدۡرِ"},{"ay":[97,2],"t":"وَمَا اَدۡرٰىكَ مَا لَيۡلَةُ الۡقَدۡرِ"},{"ay":[97,3],"t":"لَيۡلَةُ الۡقَدۡرِ خَيۡرٌ مِّنۡ اَلۡفِ شَهۡرٍؔ"}]},"w11d3":{"k":"ayat","items":[{"ay":[97,4],"t":"تَنَزَّلُ الۡمَلٰٓئِكَةُ وَالرُّوۡحُ فِيۡهَا بِاِذۡنِ رَبِّهِمۡ مِّنۡ كُلِّ اَمۡرٍ"},{"ay":[97,5],"t":"سَلٰمٌ هِيَ حَتّٰي مَطۡلَعِ الۡفَجۡرِ"},{"ay":[95,1],"t":"وَالتِّيۡنِ وَالزَّيۡتُوۡنِ"},{"ay":[95,2],"t":"وَطُوۡرِ سِيۡنِيۡنَ"},{"ay":[95,3],"t":"وَهٰذَا الۡبَلَدِ الۡاَمِيۡنِ"},{"ay":[95,4],"t":"لَقَدۡ خَلَقۡنَا الۡاِنۡسَانَ فِيۡ اَحۡسَنِ تَقۡوِيۡمٍ"},{"ay":[95,5],"t":"ثُمَّ رَدَدۡنٰهُ اَسۡفَلَ سٰفِلِيۡنَ"},{"ay":[95,6],"t":"اِلَّا الَّذِيۡنَ اٰمَنُوۡا وَعَمِلُوا الصّٰلِحٰتِ فَلَهُمۡ اَجۡرٌ غَيۡرُ مَمۡنُوۡنٍ"},{"ay":[95,7],"t":"فَمَا يُكَذِّبُكَ بَعۡدُ بِالدِّيۡنِ"}]},"w11d4":{"k":"ayat","items":[{"ay":[95,8],"t":"اَلَيۡسَ اللّٰهُ بِاَحۡكَمِ الۡحٰكِمِيۡنَ"},{"ay":[94,1],"t":"اَلَمۡ نَشۡرَحۡ لَكَ صَدۡرَكَ"},{"ay":[94,2],"t":"وَوَضَعۡنَا عَنۡكَ وِزۡرَكَ"},{"ay":[94,3],"t":"الَّذِيۡ اَنۡقَضَ ظَهۡرَكَ"},{"ay":[94,4],"t":"وَرَفَعۡنَا لَكَ ذِكۡرَكَ"},{"ay":[94,5],"t":"فَاِنَّ مَعَ الۡعُسۡرِ يُسۡرًا"},{"ay":[94,6],"t":"اِنَّ مَعَ الۡعُسۡرِ يُسۡرًا"},{"ay":[94,7],"t":"فَاِذَا فَرَغۡتَ فَانۡصَبۡ"},{"ay":[94,8],"t":"وَاِلٰي رَبِّكَ فَارۡغَبۡ"}]},"w11d5":{"k":"ayat","items":[{"ay":[93,1],"t":"وَالضُّحٰي"},{"ay":[93,2],"t":"وَالَّيۡلِ اِذَا سَجٰي"},{"ay":[93,3],"t":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلٰي"},{"ay":[93,4],"t":"وَلَلۡاٰخِرَةُ خَيۡرٌ لَّكَ مِنَ الۡاُوۡلٰي"},{"ay":[93,5],"t":"وَلَسَوۡفَ يُعۡطِيۡكَ رَبُّكَ فَتَرۡضٰي"},{"ay":[93,6],"t":"اَلَمۡ يَجِدۡكَ يَتِيۡمًا فَاٰوٰي"},{"ay":[93,7],"t":"وَوَجَدَكَ ضَآلًّا فَهَدٰي"},{"ay":[93,8],"t":"وَوَجَدَكَ عَآئِلًا فَاَغۡنٰي"},{"ay":[93,9],"t":"فَاَمَّا الۡيَتِيۡمَ فَلَا تَقۡهَرۡ"}]},"w11d6":{"k":"ayat","items":[{"ay":[93,10],"t":"وَاَمَّا السَّآئِلَ فَلَا تَنۡهَرۡ"},{"ay":[93,11],"t":"وَاَمَّا بِنِعۡمَةِ رَبِّكَ فَحَدِّثۡ"},{"ay":[92,1],"t":"وَالَّيۡلِ اِذَا يَغۡشٰي"},{"ay":[92,2],"t":"وَالنَّهَارِ اِذَا تَجَلّٰي"},{"ay":[92,3],"t":"وَمَا خَلَقَ الذَّكَرَ وَالۡاُنۡثٰي"},{"ay":[92,4],"t":"اِنَّ سَعۡيَكُمۡ لَشَتّٰي"},{"ay":[92,5],"t":"فَاَمَّا مَنۡ اَعۡطٰي وَاتَّقٰي"},{"ay":[92,6],"t":"وَصَدَّقَ بِالۡحُسۡنٰي"},{"ay":[92,7],"t":"فَسَنُيَسِّرُهٗ لِلۡيُسۡرٰي"}]},"w12d1":{"k":"ayat","items":[{"ay":[92,8],"t":"وَاَمَّا مَنۡ بَخِلَ وَاسۡتَغۡنٰي"},{"ay":[92,9],"t":"وَكَذَّبَ بِالۡحُسۡنٰي"},{"ay":[92,10],"t":"فَسَنُيَسِّرُهٗ لِلۡعُسۡرٰي"},{"ay":[92,11],"t":"وَمَا يُغۡنِيۡ عَنۡهُ مَالُهٗ اِذَا تَرَدّٰي"},{"ay":[92,12],"t":"اِنَّ عَلَيۡنَا لَلۡهُدٰي"},{"ay":[92,13],"t":"وَاِنَّ لَنَا لَلۡاٰخِرَةَ وَالۡاُوۡلٰي"},{"ay":[92,14],"t":"فَاَنۡذَرۡتُكُمۡ نَارًا تَلَظّٰي"},{"ay":[92,15],"t":"لَا يَصۡلٰىهَا اِلَّا الۡاَشۡقَي"},{"ay":[92,16],"t":"الَّذِيۡ كَذَّبَ وَتَوَلّٰي"}]},"w12d2":{"k":"ayat","items":[{"ay":[92,17],"t":"وَسَيُجَنَّبُهَا الۡاَتۡقَي"},{"ay":[92,18],"t":"الَّذِيۡ يُؤۡتِيۡ مَالَهٗ يَتَزَكّٰي"},{"ay":[92,19],"t":"وَمَا لِاَحَدٍ عِنۡدَهٗ مِنۡ نِّعۡمَةٍ تُجۡزٰي"},{"ay":[92,20],"t":"اِلَّا ابۡتِغَآءَ وَجۡهِ رَبِّهِ الۡاَعۡلٰي"},{"ay":[92,21],"t":"وَلَسَوۡفَ يَرۡضٰي"},{"ay":[91,1],"t":"وَالشَّمۡسِ وَضُحٰىهَا"},{"ay":[91,2],"t":"وَالۡقَمَرِ اِذَا تَلٰىهَا"},{"ay":[91,3],"t":"وَالنَّهَارِ اِذَا جَلّٰىهَا"},{"ay":[91,4],"t":"وَالَّيۡلِ اِذَا يَغۡشٰىهَا"}]},"w12d3":{"k":"ayat","items":[{"ay":[91,5],"t":"وَالسَّمَآءِ وَمَا بَنٰىهَا"},{"ay":[91,6],"t":"وَالۡاَرۡضِ وَمَا طَحٰىهَا"},{"ay":[91,7],"t":"وَنَفۡسٍ وَّمَا سَوّٰىهَا"},{"ay":[91,8],"t":"فَاَلۡهَمَهَا فُجُوۡرَهَا وَتَقۡوٰىهَا"},{"ay":[91,9],"t":"قَدۡ اَفۡلَحَ مَنۡ زَكّٰىهَا"},{"ay":[91,10],"t":"وَقَدۡ خَابَ مَنۡ دَسّٰىهَا"},{"ay":[91,11],"t":"كَذَّبَتۡ ثَمُوۡدُ بِطَغۡوٰىهَا"},{"ay":[91,12],"t":"اِذِ انۡ بَعَثَ اَشۡقٰىهَا"},{"ay":[91,13],"t":"فَقَالَ لَهُمۡ رَسُوۡلُ اللّٰهِ نَاقَةَ اللّٰهِ وَسُقۡيٰهَا"}]},"w12d4":{"k":"ayat","items":[{"ay":[91,14],"t":"فَكَذَّبُوۡهُ فَعَقَرُوۡهَا فَدَمۡدَمَ عَلَيۡهِمۡ رَبُّهُمۡ بِذَنۡ بِهِمۡ فَسَوّٰىهَا"},{"ay":[91,15],"t":"وَلَا يَخَافُ عُقۡبٰهَا"},{"ay":[90,1],"t":"لَا اُقۡسِمُ بِهٰذَا الۡبَلَدِ"},{"ay":[90,2],"t":"وَاَنۡتَ حِلٌّ بِهٰذَا الۡبَلَدِ"},{"ay":[90,3],"t":"وَوَالِدٍ وَّمَا وَلَدَ"},{"ay":[90,4],"t":"لَقَدۡ خَلَقۡنَا الۡاِنۡسَانَ فِيۡ كَبَدٍ"},{"ay":[90,5],"t":"اَيَحۡسَبُ اَنۡ لَّنۡ يَّقۡدِرَ عَلَيۡهِ اَحَدٌ"},{"ay":[90,6],"t":"يَقُوۡلُ اَهۡلَكۡتُ مَالًا لُّبَدًا"},{"ay":[90,7],"t":"اَيَحۡسَبُ اَنۡ لَّمۡ يَرَهٗ اَحَدٌ"}]},"w12d5":{"k":"ayat","items":[{"ay":[90,8],"t":"اَلَمۡ نَجۡعَلۡ لَّهٗ عَيۡنَيۡنِ"},{"ay":[90,9],"t":"وَلِسَانًا وَّشَفَتَيۡنِ"},{"ay":[90,10],"t":"وَهَدَيۡنٰهُ النَّجۡدَيۡنِ"},{"ay":[90,11],"t":"فَلَا اقۡتَحَمَ الۡعَقَبَةَ"},{"ay":[90,12],"t":"وَمَا اَدۡرٰىكَ مَا الۡعَقَبَةُ"},{"ay":[90,13],"t":"فَكُّ رَقَبَةٍ"},{"ay":[90,14],"t":"اَوۡ اِطۡعٰمٌ فِيۡ يَوۡمٍ ذِيۡ مَسۡغَبَةٍ"},{"ay":[90,15],"t":"يَّتِيۡمًا ذَا مَقۡرَبَةٍ"},{"ay":[90,16],"t":"اَوۡ مِسۡكِيۡنًا ذَا مَتۡرَبَةٍ"}]},"w12d6":{"k":"ayat","items":[{"ay":[90,17],"t":"ثُمَّ كَانَ مِنَ الَّذِيۡنَ اٰمَنُوۡا وَتَوَاصَوۡا بِالصَّبۡرِ وَتَوَاصَوۡا بِالۡمَرۡحَمَةِ"},{"ay":[90,18],"t":"اُولٰٓئِكَ اَصۡحٰبُ الۡمَيۡمَنَةِ"},{"ay":[90,19],"t":"وَالَّذِيۡنَ كَفَرُوۡا بِاٰيٰتِنَا هُمۡ اَصۡحٰبُ الۡمَشۡـَٔمَةِ"},{"ay":[90,20],"t":"عَلَيۡهِمۡ نَارٌ مُّؤۡصَدَةٌ"},{"ay":[89,1],"t":"وَالۡفَجۡرِ"},{"ay":[89,2],"t":"وَلَيَالٍ عَشۡرٍ"},{"ay":[89,3],"t":"وَّالشَّفۡعِ وَالۡوَتۡرِ"},{"ay":[89,4],"t":"وَالَّيۡلِ اِذَا يَسۡرِ"},{"ay":[89,5],"t":"هَلۡ فِيۡ ذٰلِكَ قَسَمٌ لِّذِيۡ حِجۡرٍ"}]}}}